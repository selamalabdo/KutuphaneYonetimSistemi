@model KutuphaneYonetimSistemi.Models.Kullanici

<h2 class="text-center text-primary my-5">Admin Girişi</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-info text-white text-center">
                    <h4>Giriş Yap</h4>
                </div>
                <div class="card-body">
                    <form asp-action="GirisYap" method="post">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı Adı:</label>
                            <input asp-for="KullaniciAdi" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Şifre:</label>
                            <input asp-for="Sifre" type="password" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                    </form>

                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @ViewBag.Hata
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
