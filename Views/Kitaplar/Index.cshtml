@model List<KutuphaneYonetimSistemi.Models.Kitap>
@{
    ViewData["Title"] = "Kitap Listesi";
}

<h2>@ViewData["Title"]</h2>

<a asp-action="Ekle" class="btn btn-success mb-3">Yeni Kitap Ekle</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Kitap Adı</th>
            <th>Yazar</th>
            <th>Yayın Yılı</th>
            <th>Tür</th>
            <th>Fiyat</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var kitap in Model)
        {
            <tr>
                <td>@kitap.KitapAdi</td>
                <td>@kitap.Yazar</td>
                <td>@kitap.YayinYili</td>
                <td>@kitap.Tur</td>
                <td>@kitap.Fiyat</td>
                <td>
                    <a asp-action="Duzenle" asp-route-id="@kitap.Id" class="btn btn-sm btn-primary">Düzenle</a>
                <a asp-action="Sil" asp-route-id="@kitap.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bu kitabı silmek istediğinizden emin misiniz?');">Sil</a>

                </td>
            </tr>
        }
    </tbody>
</table>
