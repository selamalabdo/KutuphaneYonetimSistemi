@model KutuphaneYonetimSistemi.Models.Kitap

@{
    ViewData["Title"] = "Kitap Sil";
}

<h2>@ViewData["Title"]</h2>

<h4>Bu kitabı silmek istediğinizden emin misiniz?</h4>

<div class="mb-3">
    <strong>@Model.KitapAdi</strong> - @Model.Yazar (@Model.YayinYili)
</div>

<form asp-action="Sil" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>

